network:
  version: 2
  renderer: networkd
  ethernets:
    ens4:
      dhcp4: no
      addresses:
        - 172.16.1.10/24
      routes:
        - to: 10.0.0.0/8
          via: 172.16.0.1
        - to: 172.16.0.0/16
          via: 172.16.0.1
        - to: 192.168.0.0/16
          via: 172.16.0.1
      optional: true

